     * =========================================================================
     */
    async function requestCameraAndMic() {
      const statusBox = document.getElementById("device-status-box");
      const btnStart = document.getElementById("btn-start-exam");
      const prepVideo = document.getElementById("prep-video");
      const placeholder = document.getElementById("prep-video-placeholder");
      const camBadge = document.getElementById("prep-cam-badge");
      const micWrapper = document.getElementById("mic-meter-wrapper");

      btnStart.disabled = true;
      statusBox.className = "p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm";
      statusBox.textContent = "Meminta izin akses Kamera & Mikrofon dari browser...";

      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          throw new Error("Browser tidak mendukung akses Kamera/Mikrofon (gunakan HTTPS atau Chrome/Safari terbaru).");
        }

        stopMediaStream();

        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } },
          audio: true
        });

        state.mediaStream = stream;

        // Tampilkan preview video
        prepVideo.srcObject = stream;
        prepVideo.classList.remove("hidden");
        placeholder.classList.add("hidden");
        camBadge.classList.remove("hidden");
        micWrapper.classList.remove("hidden");

        // Mulai meteran mikrofon sederhana
        startMicMeter(stream);

        statusBox.className = "p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium";
        statusBox.textContent = "Kamera & Mikrofon aktif! Anda sudah siap memulai ujian.";
        btnStart.disabled = false;
      } catch (err) {
        console.error("Izin media ditolak/gagal:", err);
        prepVideo.classList.add("hidden");
        placeholder.classList.remove("hidden");
        camBadge.classList.add("hidden");
        micWrapper.classList.add("hidden");

        statusBox.className = "p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium";
        statusBox.textContent =
          "Akses Kamera/Mikrofon DITOLAK atau tidak ditemukan. Anda wajib mengizinkan Kamera & Mikrofon di pengaturan browser agar bisa memulai ujian.";
        btnStart.disabled = true;
      }
    }

    function startMicMeter(stream) {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const audioCtx = new AudioCtx();
        const analyser = audioCtx.createAnalyser();
        const source = audioCtx.createMediaStreamSource(stream);
        analyser.fftSize = 256;
        source.connect(analyser);

        const dataArray = new Uint8Array(analyser.frequencyBinCount);
        const meterBar = document.getElementById("mic-meter-bar");

        const updateMeter = () => {
          if (!state.mediaStream || state.examActive) {
            audioCtx.close().catch(() => {});
            return;
          }
          analyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
          const avg = sum / dataArray.length;
          const pct = Math.min(100, Math.max(6, Math.round((avg / 100) * 100)));
          meterBar.style.width = `${pct}%`;
          state.micMonitorId = requestAnimationFrame(updateMeter);
        };
        updateMeter();
      } catch (e) {
        // Abaikan jika browser membatasi AudioContext sebelum klik
      }
    }

    function stopMediaStream() {
      if (state.micMonitorId) {
        cancelAnimationFrame(state.micMonitorId);
        state.micMonitorId = null;
      }
      if (state.mediaStream) {
        state.mediaStream.getTracks().forEach((t) => t.stop());
        state.mediaStream = null;
      }
    }

    document.getElementById("btn-request-media").addEventListener("click", requestCameraAndMic);

    /** Memaksa masuk Fullscreen dengan penanganan promise rejection */
    async function enterFullscreenSafely() {
      try {
        const el = document.documentElement;
        if (el.requestFullscreen) {
          await el.requestFullscreen();
        } else if (el.webkitRequestFullscreen) {
          await el.webkitRequestFullscreen();
        } else if (el.msRequestFullscreen) {
          await el.msRequestFullscreen();
        }
      } catch (err) {
        // Tangani error promise rejection (mis. di iOS Safari atau iframe) agar ujian tetap berjalan lancar
        console.warn("Mode Fullscreen tidak diizinkan browser:", err);
      }
    }

    document.getElementById("btn-start-exam").addEventListener("click", async () => {
      if (!state.mediaStream) {
        showToast("Kamera & Mikrofon wajib aktif sebelum memulai ujian!");
        return;
      }

      // Aktifkan AudioContext saat user mengklik tombol agar sirine tidak diblokir autoplay
      SirenAlarm.init();

      // Paksa Fullscreen
      await enterFullscreenSafely();

      // Pindahkan stream video ke Floating Camera di halaman ujian
      const examVideo = document.getElementById("exam-video");
      examVideo.srcObject = state.mediaStream;

      // Setup header ujian
      document.getElementById("header-student-name").textContent = `${state.studentName} (${state.studentClass})`;

      // Aktifkan state ujian
      state.examActive = true;
