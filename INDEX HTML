        }
      });
    });

    // Blokir shortcut keyboard berbahaya (F12, Ctrl+C/V/U/S/P, DevTools, PrintScreen)
    document.addEventListener("keydown", (e) => {
      if (!state.examActive) return;

      const key = e.key.toLowerCase();
      const ctrlOrMeta = e.ctrlKey || e.metaKey;

      const isBlockedShortcut =
        e.key === "F12" ||
        e.key === "PrintScreen" ||
        (ctrlOrMeta && ["c", "v", "x", "u", "s", "p", "a"].includes(key)) ||
        (ctrlOrMeta && e.shiftKey && ["i", "j", "c"].includes(key));

      if (isBlockedShortcut) {
        e.preventDefault();
        e.stopPropagation();
        showToast("Shortcut keyboard diblokir selama ujian!");
      }
    });

    /**
     * Penanganan keluar layar / pindah tab dengan DEBOUNCE
     * Mencegah event `blur` dan `visibilitychange` terhitung ganda secara bersamaan.
     */
    function handleCheatDetected(reason) {
      if (!state.examActive || state.examSubmitted) return;

      const now = Date.now();
      // Jika masih dalam jendela debounce, cukup pastikan sirine menyala tanpa menambah hitungan pelanggaran
      if (now - state.lastViolationTimestamp < VIOLATION_DEBOUNCE_MS) {
        SirenAlarm.start();
        return;
      }

      state.lastViolationTimestamp = now;
      state.violations += 1;
      updateExamStats();

      // Bunyikan alarm sirine Web Audio API
      SirenAlarm.start();

      if (state.violations >= MAX_VIOLATIONS) {
        // Pelanggaran ke-3: Auto-submit & Diskualifikasi
        SirenAlarm.stop();
        document.getElementById("modal-warning").classList.add("hidden");
        submitExam("Diskualifikasi (Curang)");
      } else {
        // Tampilkan modal peringatan
        const left = MAX_VIOLATIONS - state.violations;
        document.getElementById("warning-count-text").textContent = state.violations;
        document.getElementById("warning-left-text").textContent = left;
        document.getElementById("warning-modal-msg").textContent =
          `Anda terdeteksi ${reason}. Segera tetap berada di halaman ujian! Jika mencapai 3 kali pelanggaran, ujian akan otomatis dihentikan.`;
        document.getElementById("modal-warning").classList.remove("hidden");
      }
    }

    // Event 1: Pindah tab / minimize browser
    document.addEventListener("visibilitychange", () => {
      if (!state.examActive || state.examSubmitted) return;

      if (document.hidden) {
        handleCheatDetected("berpindah tab atau menutup layar ujian");
      } else {
        // Alarm hanya mati jika siswa kembali ke halaman ujian
        SirenAlarm.stop();
      }
    });

    // Event 2: Kehilangan fokus jendela (buka aplikasi lain / split screen)
    window.addEventListener("blur", () => {
      if (!state.examActive || state.examSubmitted) return;
      handleCheatDetected("keluar dari jendela fokus ujian");
    });

    // Matikan sirine saat jendela kembali fokus (siswa kembali ke halaman ujian)
    window.addEventListener("focus", () => {
      if (!state.examActive || state.examSubmitted) return;
      SirenAlarm.stop();
    });

    // Tombol tutup modal peringatan & masuk kembali ke fullscreen
    document.getElementById("btn-dismiss-warning").addEventListener("click", () => {
