    /**
     * =========================================================================
     * 4. LOGIKA HALAMAN UJIAN, TIMER 90 MENIT & MODAL DAFTAR SOAL
     * =========================================================================
     */
    function startExamTimer() {
      clearInterval(state.timerInterval);
      updateTimerDisplay();

      state.timerInterval = setInterval(() => {
        if (!state.examActive || state.examSubmitted) {
          clearInterval(state.timerInterval);
          return;
        }
        state.remainingSeconds -= 1;
        updateTimerDisplay();

        if (state.remainingSeconds <= 0) {
          clearInterval(state.timerInterval);
          submitExam("Waktu Habis");
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const mins = Math.floor(Math.max(0, state.remainingSeconds) / 60);
      const secs = Math.max(0, state.remainingSeconds) % 60;
      const formatted = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
      document.getElementById("timer-display").textContent = formatted;

      // Ubah warna badge timer menjadi merah saat sisa waktu < 5 menit
      const badge = document.getElementById("timer-badge");
      if (state.remainingSeconds <= 300) {
        badge.classList.remove("bg-slate-900");
        badge.classList.add("bg-rose-600", "animate-pulse");
      } else {
        badge.classList.add("bg-slate-900");
        badge.classList.remove("bg-rose-600", "animate-pulse");
      }
    }

    function renderQuestion() {
      const q = QUESTIONS[state.currentIndex];
      const selected = state.answers[q.id];

      document.getElementById("q-number").textContent = state.currentIndex + 1;
      document.getElementById("q-topic").textContent = q.topic;
      document.getElementById("q-text").textContent = q.question;
      document.getElementById("footer-q-pos").textContent = `${state.currentIndex + 1} / ${QUESTIONS.length}`;

      const statusPill = document.getElementById("q-status-pill");
      if (selected) {
        statusPill.textContent = `Terjawab (${selected})`;
        statusPill.className = "px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700";
      } else {
        statusPill.textContent = "Belum dijawab";
        statusPill.className = "px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500";
      }

      // Render Pilihan A, B, C, D
      const optionsContainer = document.getElementById("q-options");
      optionsContainer.innerHTML = "";

      ["A", "B", "C", "D"].forEach((letter) => {
        const isSelected = selected === letter;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          `w-full text-left p-3.5 sm:p-4 rounded-2xl border-2 transition flex items-start gap-3 active:scale-[0.99] ` +
          (isSelected
            ? "border-blue-600 bg-blue-50/90 text-blue-950 shadow-sm"
            : "border-slate-200 bg-white hover:border-blue-300 hover:bg-slate-50 text-slate-800");

        btn.innerHTML = `
          <span class="shrink-0 w-8 h-8 rounded-xl flex items-center justify-center font-bold text-sm ${
            isSelected ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-700"
          }">${letter}</span>
          <span class="pt-1 text-sm sm:text-base font-medium leading-snug">${q.options[letter]}</span>
        `;

        btn.addEventListener("click", () => {
          state.answers[q.id] = letter;
          renderQuestion();
          updateExamStats();
        });

        optionsContainer.appendChild(btn);
      });

      // Update status tombol Sebelumnya / Selanjutnya
      document.getElementById("btn-prev").disabled = state.currentIndex === 0;
      const btnNext = document.getElementById("btn-next");
      if (state.currentIndex === QUESTIONS.length - 1) {
        btnNext.classList.add("hidden");
      } else {
        btnNext.classList.remove("hidden");
      }

      // Scroll ke atas area soal setiap pindah nomor
      document.getElementById("question-scroll-area").scrollTop = 0;
    }

    function updateExamStats() {
      const answeredCount = Object.keys(state.answers).length;
      const unansweredCount = QUESTIONS.length - answeredCount;
      const warningsLeft = Math.max(0, MAX_VIOLATIONS - state.violations);

      document.getElementById("stat-answered").textContent = answeredCount;
      document.getElementById("stat-unanswered").textContent = unansweredCount;
      document.getElementById("stat-warnings-left").textContent = warningsLeft;
    }

    function renderNavModalGrid() {
      const grid = document.getElementById("nav-grid");
      grid.innerHTML = "";

      const answeredCount = Object.keys(state.answers).length;
      document.getElementById("modal-nav-summary").textContent = `${answeredCount} / ${QUESTIONS.length} terjawab`;

      QUESTIONS.forEach((q, idx) => {
        const isCurrent = idx === state.currentIndex;
        const isAnswered = Boolean(state.answers[q.id]);

        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = idx + 1;

        // Warna kotak nomor: Biru (aktif), Hijau (sudah dijawab), Putih (belum)
        let colorClass = "bg-white border-slate-300 text-slate-700 hover:bg-slate-100";
        if (isCurrent) {
          colorClass = "bg-blue-600 border-blue-600 text-white ring-2 ring-blue-300 shadow-sm";
        } else if (isAnswered) {
          colorClass = "bg-emerald-500 border-emerald-600 text-white hover:bg-emerald-600";
        }

        btn.className = `h-10 rounded-xl border font-bold text-sm transition active:scale-95 ${colorClass}`;
        btn.addEventListener("click", () => {
          state.currentIndex = idx;
          renderQuestion();
          document.getElementById("modal-nav").classList.add("hidden");
        });

        grid.appendChild(btn);
      });
    }

    // Event tombol navigasi soal
    document.getElementById("btn-prev").addEventListener("click", () => {
      if (state.currentIndex > 0) {
        state.currentIndex -= 1;
        renderQuestion();
      }
    });

    document.getElementById("btn-next").addEventListener("click", () => {
      if (state.currentIndex < QUESTIONS.length - 1) {
        state.currentIndex += 1;
        renderQuestion();
      }
    });

    // Modal Daftar Soal
    document.getElementById("btn-open-nav-modal").addEventListener("click", () => {
      renderNavModalGrid();
      document.getElementById("modal-nav").classList.remove("hidden");
    });

    document.getElementById("btn-close-nav-modal").addEventListener("click", () => {
      document.getElementById("modal-nav").classList.add("hidden");
    });

    document.getElementById("modal-nav").addEventListener("click", (e) => {
      if (e.target.id === "modal-nav") {
        document.getElementById("modal-nav").classList.add("hidden");
      }
    });

    /**
     * =========================================================================
     * FLOATING CAMERA DRAG & DROP (TOUCH & MOUSE) DENGAN BATASAN LAYAR
     * =========================================================================
     */
    let camDragInitialized = false;
    function initDraggableCamera() {
      if (camDragInitialized) return;
      camDragInitialized = true;

      const cam = document.getElementById("floating-cam");
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      const getPointerPos = (e) => {
        if (e.touches && e.touches.length > 0) {
          return { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
        return { x: e.clientX, y: e.clientY };
      };

      const clampPosition = (left, top) => {
        const margin = 8;
        const maxLeft = window.innerWidth - cam.offsetWidth - margin;
        const maxTop = window.innerHeight - cam.offsetHeight - margin;
        return {
          left: Math.min(Math.max(margin, left), Math.max(margin, maxLeft)),
          top: Math.min(Math.max(margin, top), Math.max(margin, maxTop))
        };
      };

      const onStart = (e) => {
        const rect = cam.getBoundingClientRect();
        // Konversi posisi right/bottom menjadi left/top agar geser mulus
        cam.style.right = "auto";
        cam.style.bottom = "auto";
        cam.style.left = `${rect.left}px`;
        cam.style.top = `${rect.top}px`;

        const pos = getPointerPos(e);
        startX = pos.x;
        startY = pos.y;
        initialLeft = rect.left;
        initialTop = rect.top;
        isDragging = true;
      };

      const onMove = (e) => {
        if (!isDragging) return;
        if (e.cancelable) e.preventDefault(); // Cegah halaman ikut ter-scroll di HP

        const pos = getPointerPos(e);
        const dx = pos.x - startX;
        const dy = pos.y - startY;
        const clamped = clampPosition(initialLeft + dx, initialTop + dy);

        cam.style.left = `${clamped.left}px`;
        cam.style.top = `${clamped.top}px`;
      };

      const onEnd = () => {
        isDragging = false;
      };

      // Mouse Events
      cam.addEventListener("mousedown", onStart);
      window.addEventListener("mousemove", onMove);
      window.addEventListener("mouseup", onEnd);

      // Touch Events (HP / Tablet)
      cam.addEventListener("touchstart", onStart, { passive: false });
      window.addEventListener("touchmove", onMove, { passive: false });
      window.addEventListener("touchend", onEnd);

      // Pastikan tetap di dalam layar saat orientasi HP berubah
      window.addEventListener("resize", () => {
        if (!state.examActive) return;
        const rect = cam.getBoundingClientRect();
        const clamped = clampPosition(rect.left, rect.top);
        cam.style.right = "auto";
        cam.style.bottom = "auto";
        cam.style.left = `${clamped.left}px`;
        cam.style.top = `${clamped.top}px`;
      });
    }

    /**
     * =========================================================================
     * 5. PENGUMPULAN UJIAN, HITUNG SKOR & KIRIM KE GOOGLE SHEETS
     * =========================================================================
     */
    function openConfirmFinishModal() {
      const answered = Object.keys(state.answers).length;
      const unanswered = QUESTIONS.length - answered;
      document.getElementById("confirm-answered").textContent = answered;
      document.getElementById("confirm-unanswered").textContent = unanswered;
      document.getElementById("modal-nav").classList.add("hidden");
      document.getElementById("modal-confirm-finish").classList.remove("hidden");
    }

    document.getElementById("btn-finish").addEventListener("click", openConfirmFinishModal);
    document.getElementById("btn-modal-finish").addEventListener("click", openConfirmFinishModal);

    document.getElementById("btn-cancel-finish").addEventListener("click", () => {
      document.getElementById("modal-confirm-finish").classList.add("hidden");
    });

    document.getElementById("btn-confirm-submit").addEventListener("click", () => {
      document.getElementById("modal-confirm-finish").classList.add("hidden");
      submitExam("Selesai");
    });

    function submitExam(statusLabel) {
      if (state.examSubmitted) return;
      state.examSubmitted = true;
      state.examActive = false;

      clearInterval(state.timerInterval);
      SirenAlarm.stop();
      stopMediaStream();

      // Keluar dari mode Fullscreen jika masih aktif
      if (document.fullscreenElement) {
        document.exitFullscreen().catch(() => {});
      }

      // Hitung jawaban benar & skor maksimal 100
      let correctCount = 0;
      const detailArr = [];

      QUESTIONS.forEach((q, idx) => {
        const userAns = state.answers[q.id] || "-";
        if (userAns === q.answer) {
          correctCount += 1;
        }
        detailArr.push(`${idx + 1}:${userAns}`);
      });

      const answeredCount = Object.keys(state.answers).length;
      const rawScore = (correctCount / QUESTIONS.length) * 100;
      const finalScore = Number.isInteger(rawScore) ? rawScore : Number(rawScore.toFixed(2));

      // Format waktu lokal Indonesia
      const nowStr = new Date().toLocaleString("id-ID", {
        dateStyle: "medium",
        timeStyle: "medium"
      });

      // Siapkan payload untuk Google Sheets
      const payload = {
        Waktu: nowStr,
        Nama: state.studentName,
        Kelas: state.studentClass,
        Skor: finalScore,
        Status: statusLabel,
        JumlahTerjawab: `${answeredCount}/${QUESTIONS.length}`,
        DetailJawaban: detailArr.join(", ")
      };
      state.lastPayload = payload;

      // Tampilkan halaman hasil
      renderResultPage(payload, correctCount, answeredCount);
      showPage("result");

      // Kirim data ke Google Sheets Webhook
      sendToGoogleSheets(payload);
    }

    function renderResultPage(payload, correctCount, answeredCount) {
      const header = document.getElementById("result-header");
      const title = document.getElementById("result-title");
      const statusEl = document.getElementById("res-status");

      if (payload.Status.includes("Diskualifikasi")) {
        header.className = "px-6 py-7 text-center text-white bg-gradient-to-r from-rose-600 to-red-700";
        title.textContent = "Ujian Dihentikan!";
        statusEl.className = "text-rose-600 font-bold";
      } else if (payload.Status === "Waktu Habis") {
        header.className = "px-6 py-7 text-center text-white bg-gradient-to-r from-amber-500 to-orange-600";
        title.textContent = "Waktu Ujian Habis";
        statusEl.className = "text-amber-600 font-bold";
      } else {
        header.className = "px-6 py-7 text-center text-white bg-gradient-to-r from-emerald-600 to-teal-600";
        title.textContent = "Ujian Selesai!";
        statusEl.className = "text-emerald-600 font-bold";
      }

      document.getElementById("result-score").textContent = payload.Skor;
      document.getElementById("res-nama").textContent = payload.Nama;
      document.getElementById("res-kelas").textContent = payload.Kelas;
      statusEl.textContent = payload.Status;
      document.getElementById("res-answered").textContent = `${answeredCount} dari ${QUESTIONS.length} soal`;
      document.getElementById("res-correct").textContent = `${correctCount} soal`;
      document.getElementById("res-violations").textContent = `${state.violations} kali`;
    }

    /**
     * Mengirim data hasil ujian ke Google Apps Script menggunakan fetch()
     */
    async function sendToGoogleSheets(payload) {
      const box = document.getElementById("sync-status-box");
      const text = document.getElementById("sync-status-text");
      const spinner = document.getElementById("sync-spinner");
      const retryBtn = document.getElementById("btn-retry-sync");

      // Status awal: Mengirim data...
      box.className = "p-3.5 rounded-xl bg-blue-50 border border-blue-200 text-blue-800 text-sm font-semibold flex items-center justify-center gap-2.5";
      spinner.classList.remove("hidden");
      text.textContent = "Mengirim data...";
      retryBtn.classList.add("hidden");

      const isDummyUrl = GOOGLE_SCRIPT_URL.includes("GANTI_DENGAN_URL_APPS_SCRIPT_ANDA");

      try {
        if (isDummyUrl) {
          // Simulasi pengiriman jika guru belum mengganti URL dummy Apps Script
          await new Promise((resolve) => setTimeout(resolve, 1200));
          console.info("Mode Demo (URL Dummy). Payload siap kirim ke Google Sheets:", payload);
        } else {
          // Pengiriman nyata ke Google Apps Script Web App
          await fetch(GOOGLE_SCRIPT_URL, {
            method: "POST",
            mode: "no-cors",
            headers: {
              "Content-Type": "text/plain;charset=utf-8"
            },
            body: JSON.stringify(payload)
          });
        }

        // Sukses
        spinner.classList.add("hidden");
        box.className = "p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-bold flex items-center justify-center gap-2";
        text.textContent = "Data berhasil terkirim";
      } catch (err) {
        console.error("Gagal mengirim data ke Google Sheets:", err);
        spinner.classList.add("hidden");
        box.className = "p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-bold flex items-center justify-center gap-2";
        text.textContent = "Gagal mengirim data. Periksa koneksi internet Anda.";
        retryBtn.classList.remove("hidden");
      }
    }

    document.getElementById("btn-retry-sync").addEventListener("click", () => {
      if (state.lastPayload) {
        sendToGoogleSheets(state.lastPayload);
      }
    });
  </script>
