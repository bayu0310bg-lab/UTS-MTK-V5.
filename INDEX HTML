    /**
     * =========================================================================
     * SISTEM ALARM SIRINE (MURNI WEB AUDIO API - TANPA FILE MP3)
     * =========================================================================
     */
    const SirenAlarm = {
      ctx: null,
      osc: null,
      lfo: null,
      lfoGain: null,
      mainGain: null,
      isPlaying: false,

      /** Inisialisasi AudioContext (harus dipanggil saat interaksi klik user) */
      init() {
        try {
          if (!this.ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AudioCtx();
          }
          if (this.ctx.state === "suspended") {
            this.ctx.resume().catch(() => {});
          }
        } catch (err) {
          console.warn("Web Audio API tidak tersedia:", err);
        }
      },

      /** Menyalakan suara sirine berfrekuensi naik-turun */
      start() {
        if (this.isPlaying) return;
        try {
          this.init();
          if (!this.ctx) return;

          const now = this.ctx.currentTime;
          this.osc = this.ctx.createOscillator();
          this.lfo = this.ctx.createOscillator();
          this.lfoGain = this.ctx.createGain();
          this.mainGain = this.ctx.createGain();

          // Suara sirine tegas (sawtooth dengan modulasi LFO)
          this.osc.type = "sawtooth";
          this.osc.frequency.setValueAtTime(880, now);

          this.lfo.type = "sine";
          this.lfo.frequency.setValueAtTime(2.5, now); // 2.5 siklus per detik
          this.lfoGain.gain.setValueAtTime(320, now);  // Rentang frekuensi 560Hz - 1200Hz

          this.mainGain.gain.setValueAtTime(0.35, now);

          this.lfo.connect(this.lfoGain);
          this.lfoGain.connect(this.osc.frequency);
          this.osc.connect(this.mainGain);
          this.mainGain.connect(this.ctx.destination);

          this.osc.start(now);
          this.lfo.start(now);
          this.isPlaying = true;
        } catch (err) {
          console.warn("Gagal menyalakan sirine:", err);
        }
      },

      /** Mematikan sirine secara aman */
      stop() {
        if (!this.isPlaying) return;
        try {
          if (this.osc) {
            this.osc.stop();
            this.osc.disconnect();
          }
          if (this.lfo) {
            this.lfo.stop();
            this.lfo.disconnect();
          }
          if (this.lfoGain) this.lfoGain.disconnect();
          if (this.mainGain) this.mainGain.disconnect();
        } catch (err) {
          console.warn("Gagal mematikan sirine:", err);
        } finally {
          this.osc = null;
          this.lfo = null;
          this.lfoGain = null;
          this.mainGain = null;
          this.isPlaying = false;
        }
      }
    };

