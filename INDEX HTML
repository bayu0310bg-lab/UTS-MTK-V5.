<!DOCTYPE html>
<html lang="id" translate="no">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <!-- Mencegah browser (Google Chrome/Edge) menerjemahkan soal Matematika secara otomatis -->
  <meta name="google" content="notranslate" />
  <title>CBT Sumatif Akhir Semester - Matematika Kelas 8</title>

  <!-- Font Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
        },
      },
    };
  </script>

  <style>
    /* Pengaturan dasar anti-seleksi teks & anti-callouts di mobile */
    html, body {
      font-family: 'Inter', system-ui, sans-serif;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      -webkit-touch-callout: none;
      overscroll-behavior: none;
    }

    /* Izinkan seleksi teks hanya pada kolom input login */
    input, select {
      -webkit-user-select: auto;
      user-select: auto;
    }

    /* Custom scrollbar lembut untuk area soal */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Animasi denyut merah untuk indikator rekaman kamera */
    @keyframes recPulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.25; }
    }
    .animate-rec {
      animation: recPulse 1.2s ease-in-out infinite;
    }

    /* Mencegah efek drag gambar/video bawaan browser */
    video {
      pointer-events: none;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased notranslate min-h-screen" translate="no">

  <!-- ===================================================================== -->
  <!-- 1. HALAMAN LOGIN                                                      -->
  <!-- ===================================================================== -->
  <section id="page-login" class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-blue-900 via-indigo-900 to-slate-900">
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border border-white/20">
      <!-- Header Kartu Login -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-7 text-center text-white">
        <div class="w-14 h-14 mx-auto mb-3 bg-white/15 backdrop-blur rounded-2xl flex items-center justify-center border border-white/25">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <span class="inline-block px-3 py-1 text-xs font-semibold tracking-wider uppercase bg-white/20 rounded-full mb-2">
          CBT Anti-Cheat System
        </span>
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight">SUMATIF AKHIR SEMESTER</h1>
        <p class="text-blue-100 text-sm mt-1 font-medium">Mata Pelajaran: MATEMATIKA • Kelas VIII</p>
      </div>

      <!-- Form Login -->
      <form id="login-form" class="p-6 sm:p-7 space-y-5" novalidate>
        <!-- Pesan Error Inline -->
        <div id="login-error" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-medium flex items-start gap-2.5">
          <svg class="w-5 h-5 shrink-0 mt-0.5 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
          <span id="login-error-text"></span>
        </div>

        <div>
          <label for="input-nama" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Nama Lengkap <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="input-nama"
            placeholder="Masukkan nama lengkap sesuai absen"
            autocomplete="off"
            required
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm sm:text-base"
          />
        </div>

        <div>
          <label for="input-kelas" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Kelas <span class="text-rose-500">*</span>
          </label>
          <select
            id="input-kelas"
            required
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm sm:text-base"
          >
            <option value="">-- Pilih Kelas --</option>
            <option value="8 A">8 A</option>
            <option value="8 B">8 B</option>
            <option value="8 C">8 C</option>
            <option value="8 D">8 D</option>
          </select>
        </div>

        <div>
          <label for="input-token" class="block text-sm font-semibold text-slate-700 mb-1.5">
            Token Ujian <span class="text-rose-500">*</span>
          </label>
          <input
            type="password"
            id="input-token"
            inputmode="numeric"
            placeholder="Masukkan 5 digit token ujian"
            autocomplete="off"
            required
            class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-slate-50 text-slate-900 tracking-widest font-semibold focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition text-sm sm:text-base"
          />
          <p class="text-xs text-slate-500 mt-1.5">Hubungi pengawas ujian jika belum mendapatkan token.</p>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 px-5 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-[0.99] text-white font-bold text-base shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2"
        >
          <span>Lanjut ke Pemeriksaan Perangkat</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </button>

        <div class="pt-2 border-t border-slate-100 text-center text-xs text-slate-500 space-y-1">
          <p>Durasi Ujian: <strong class="text-slate-700">90 Menit</strong> • Jumlah Soal: <strong class="text-slate-700" id="login-total-soal">40 Soal</strong></p>
          <p>Sistem dilengkapi pengawasan kamera & deteksi pindah tab otomatis.</p>
        </div>
      </form>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 2. HALAMAN PERSIAPAN (DEVICE CHECK)                                   -->
  <!-- ===================================================================== -->
  <section id="page-prep" class="hidden min-h-screen flex items-center justify-center p-4 bg-slate-100">
    <div class="w-full max-w-2xl bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden">
      <div class="bg-slate-900 px-6 py-5 text-white flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-lg sm:text-xl font-bold">Pemeriksaan Perangkat & Aturan Ujian</h2>
          <p class="text-xs sm:text-sm text-slate-300" id="prep-student-info">Peserta: -</p>
        </div>
        <button
          id="btn-back-login"
          type="button"
          class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs font-semibold transition"
        >
          Ganti Akun
        </button>
      </div>

      <div class="p-5 sm:p-7 space-y-6">
        <!-- Area Preview Kamera -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-center">
          <div class="relative rounded-2xl overflow-hidden bg-slate-900 aspect-video border-2 border-slate-200 flex items-center justify-center">
            <video id="prep-video" autoplay playsinline muted class="w-full h-full object-cover hidden transform -scale-x-100"></video>
            <div id="prep-video-placeholder" class="text-center p-4 text-slate-400">
              <svg class="w-12 h-12 mx-auto mb-2 opacity-60" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z" />
              </svg>
              <p class="text-xs sm:text-sm font-medium">Menunggu izin Kamera & Mikrofon...</p>
            </div>
            <div id="prep-cam-badge" class="hidden absolute top-2.5 left-2.5 px-2.5 py-1 rounded-full bg-emerald-600/90 text-white text-xs font-semibold flex items-center gap-1.5 shadow">
              <span class="w-2 h-2 rounded-full bg-white animate-rec"></span>
              Kamera Aktif
            </div>
          </div>

          <!-- Status Perangkat -->
          <div class="space-y-3">
            <h3 class="font-bold text-slate-800 text-base">Status Izin Perangkat</h3>
            <div id="device-status-box" class="p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-sm">
              Klik tombol di bawah untuk mengaktifkan Kamera & Mikrofon. Ujian tidak dapat dimulai tanpa izin perangkat.
            </div>

            <!-- Indikator Audio Sederhana -->
            <div id="mic-meter-wrapper" class="hidden space-y-1">
              <div class="flex justify-between text-xs font-medium text-slate-600">
                <span>Tes Mikrofon (Suara Terdeteksi)</span>
                <span class="text-emerald-600 font-semibold">Aktif</span>
              </div>
              <div class="w-full h-2.5 bg-slate-200 rounded-full overflow-hidden">
                <div id="mic-meter-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-75" style="width: 5%;"></div>
              </div>
            </div>

            <button
              id="btn-request-media"
              type="button"
              class="w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm shadow transition flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
              </svg>
              <span>Izinkan Kamera & Mikrofon</span>
            </button>
          </div>
        </div>

        <!-- Peraturan Anti-Curang -->
        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-4 space-y-2">
          <h4 class="font-bold text-rose-800 text-sm flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
            PERATURAN KETAT ANTI-CURANG
          </h4>
          <ul class="text-xs sm:text-sm text-rose-900/90 space-y-1.5 list-disc pl-5">
            <li>Ujian akan berjalan dalam mode <strong>Layar Penuh (Fullscreen)</strong> dengan kamera pengawas aktif.</li>
            <li>Dilarang pindah tab, membuka aplikasi lain, split-screen, atau memperkecil layar.</li>
            <li>Jika keluar dari halaman ujian, <strong>alarm sirine akan berbunyi keras</strong> hingga Anda kembali.</li>
            <li>Batas maksimal pelanggaran adalah <strong>3 kali</strong>. Pelanggaran ke-3 akan langsung menghentikan ujian dengan status <strong>Diskualifikasi (Curang)</strong>.</li>
            <li>Klik kanan, salin teks (copy-paste), dan terjemahan otomatis dinonaktifkan.</li>
          </ul>
        </div>

        <!-- Tombol Mulai Ujian -->
        <button
          id="btn-start-exam"
          type="button"
          disabled
          class="w-full py-4 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 disabled:text-slate-500 disabled:cursor-not-allowed text-white font-extrabold text-base shadow-lg transition flex items-center justify-center gap-2"
        >
          <span>MULAI UJIAN SEKARANG</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- 3. HALAMAN UJIAN (MOBILE-FRIENDLY, STICKY HEADER & STICKY FOOTER)     -->
  <!-- ===================================================================== -->
  <section id="page-exam" class="hidden h-[100dvh] flex flex-col overflow-hidden bg-slate-100">

    <!-- STICKY HEADER -->
    <header class="shrink-0 bg-white border-b border-slate-200 shadow-sm z-20 px-3 sm:px-5 py-2.5">
      <div class="max-w-5xl mx-auto flex items-center justify-between gap-2">
        <!-- Kiri: Mapel & Info Siswa -->
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded-md bg-blue-100 text-blue-800 text-[11px] font-bold uppercase tracking-wide">
              MTK VIII
            </span>
            <h1 id="header-student-name" class="text-xs sm:text-sm font-bold text-slate-800 truncate">
              Nama Siswa
            </h1>
          </div>
          <!-- Indikator Status Ringkas -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 mt-1 text-[11px] sm:text-xs font-medium text-slate-600">
            <span class="inline-flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Terjawab: <strong id="stat-answered" class="text-slate-900">0</strong>
            </span>
            <span class="inline-flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-slate-300"></span>
              Belum: <strong id="stat-unanswered" class="text-slate-900">40</strong>
            </span>
            <span class="inline-flex items-center gap-1 text-rose-600 font-semibold">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z" />
              </svg>
              Sisa Peringatan: <strong id="stat-warnings-left">3</strong>/3
            </span>
          </div>
        </div>

        <!-- Kanan: Timer 90 Menit & Tombol Popup Daftar Soal -->
        <div class="flex items-center gap-2 shrink-0">
          <!-- Timer -->
          <div id="timer-badge" class="px-2.5 sm:px-3.5 py-1.5 rounded-xl bg-slate-900 text-white font-mono font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm">
            <svg class="w-4 h-4 text-blue-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="timer-display">90:00</span>
          </div>

          <!-- Tombol Daftar Soal (Modal Popup) -->
          <button
            id="btn-open-nav-modal"
            type="button"
            class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-semibold text-xs sm:text-sm shadow-sm flex items-center gap-1.5 transition"
            title="Buka Daftar Soal"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
            </svg>
            <span class="hidden sm:inline">Daftar Soal</span>
            <span class="sm:hidden">Soal</span>
          </button>
        </div>
      </div>
    </header>

    <!-- AREA KONTEN SOAL (SCROLLABLE MANDIRI) -->
    <main id="question-scroll-area" class="flex-1 overflow-y-auto custom-scroll px-3 sm:px-5 py-4 sm:py-6">
      <div class="max-w-3xl mx-auto pb-8">
        <!-- Kartu Soal -->
        <div class="bg-white rounded-2xl sm:rounded-3xl shadow-sm border border-slate-200 p-4 sm:p-7 notranslate" translate="no">
          <!-- Meta Soal -->
          <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-xl bg-blue-600 text-white font-bold text-xs sm:text-sm">
                Soal No. <span id="q-number">1</span>
              </span>
              <span id="q-topic" class="px-2.5 py-1 rounded-xl bg-slate-100 text-slate-600 font-semibold text-xs">
                Materi
              </span>
            </div>
            <span id="q-status-pill" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">
              Belum dijawab
            </span>
          </div>

          <!-- Teks Soal -->
          <div id="q-text" class="text-slate-900 text-base sm:text-lg font-medium leading-relaxed mb-6">
            Memuat soal...
          </div>

          <!-- Pilihan Jawaban A, B, C, D -->
          <div id="q-options" class="space-y-3">
            <!-- Di-render dinamis oleh JS -->
          </div>
        </div>
      </div>
    </main>

    <!-- STICKY FOOTER (TOMBOL NAVIGASI BAWAH) -->
    <footer class="shrink-0 bg-white border-t border-slate-200 px-3 sm:px-5 py-3 z-20 shadow-[0_-4px_12px_rgba(15,23,42,0.05)]">
      <div class="max-w-3xl mx-auto flex items-center justify-between gap-2">
        <!-- Tombol Sebelumnya -->
        <button
          id="btn-prev"
          type="button"
          class="px-3.5 sm:px-5 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed text-slate-700 font-semibold text-xs sm:text-sm flex items-center gap-1.5 transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          <span>Sebelumnya</span>
        </button>

        <!-- Indikator Posisi Tengah -->
        <div class="text-xs sm:text-sm font-bold text-slate-600 text-center">
          <span id="footer-q-pos">1 / 40</span>
        </div>

        <!-- Tombol Selanjutnya & Selesai -->
        <div class="flex items-center gap-2">
          <button
            id="btn-next"
            type="button"
            class="px-3.5 sm:px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 active:scale-95 text-white font-semibold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm transition"
          >
            <span>Selanjutnya</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>

          <button
            id="btn-finish"
            type="button"
            class="px-3.5 sm:px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold text-xs sm:text-sm flex items-center gap-1.5 shadow-sm transition"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
